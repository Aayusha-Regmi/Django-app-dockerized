version: '3.9'
services:
  nginx:
    build: ./nginx
    ports: 
     - "80:80"
    container_name: nginx
    networks: 
      - notes-app-network
    restart: always
    depends_on:
      - django-app
  
  db_cont:
    image: mysql
    container_name: db_cont
    ports: 
      - "3306:3306"
    environment:
      MYSQL_DATABASE: "test_db"
      MYSQL_ROOT_PASSWORD: "root"
    networks: 
      - notes-app-network
    volumes:
      - ./mysql-data:/var/lib/mysql
    restart: always
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot","-proot"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s



  django-app:
    image: notes-app-backend:latest
    container_name: django-app
    env_file: ".env"
    ports: 
      - "8000:8000"
    networks:
      - notes-app-network
    command: sh /entrypoint.sh
    restart: always
    depends_on:
      db_cont:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL","curl -f http://localhost:8000/health ||exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s

networks:
  notes-app-network:

volumes:
  mysql-data:
 
